<Project Sdk="Microsoft.NET.Sdk">

  <!-- Common build + package metadata is in src/Directory.Build.props -->
  <PropertyGroup>
    <PackageId>StoreBridge.Apple</PackageId>
    <Description>Apple App Store Server API integration for subscription verification and webhook handling in .NET.</Description>
    <PackageTags>apple;appstore;subscription;iap;in-app-purchase;storekit;billing;mobile</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>StoreBridge.Apple.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StoreBridge\StoreBridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared internal helpers compiled into each platform package -->
    <Compile Include="..\Shared\LogRedaction.cs" Link="Internal\LogRedaction.cs" />
  </ItemGroup>

</Project>
