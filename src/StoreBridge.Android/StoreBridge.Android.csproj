<Project Sdk="Microsoft.NET.Sdk">

  <!-- Common build + package metadata is in src/Directory.Build.props -->
  <PropertyGroup>
    <PackageId>StoreBridge.Android</PackageId>
    <Description>Google Play Developer API client (subscriptionsv2, productsv2) and Real-time Developer Notifications handling for .NET: verify subscriptions and one-time purchases, and authenticate Pub/Sub push webhooks (OIDC).</Description>
    <PackageTags>google;android;googleplay;google-play-billing;play-developer-api;rtdn;pubsub;subscription;iap;in-app-purchase;webhooks;billing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.AndroidPublisher.v3" Version="1.78.0.4316" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>StoreBridge.Android.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StoreBridge\StoreBridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared internal helpers compiled into each platform package -->
    <Compile Include="..\Shared\LogRedaction.cs" Link="Internal\LogRedaction.cs" />
  </ItemGroup>

</Project>
